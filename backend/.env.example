# IBM watsonx.ai credentials (required for live IBM Granite 4 inference)
# Without these, the app runs in mock mode with deterministic responses.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model selection — granite-4-h-small verified live via model.chat() API
# Other available models (project-dependent): ibm/granite-3-1-8b-base
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Optional overrides
MISSION_ELAPSED_DAY=142
